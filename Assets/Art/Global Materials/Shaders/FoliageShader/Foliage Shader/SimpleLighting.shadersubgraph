    "m_FunctionName": "SimpleUnlitLighting",
    "m_FunctionSource": "bfe76908ca9b98142a6159a9acf0864f",
    "m_FunctionBody": "#ifndef MINIMAL_LIGHTING_INCLUDED\r\n#define MINIMAL_LIGHTING_INCLUDED\r\n\r\n// Make sure your Custom Function Node \"Name\" field is exactly: minimalLighting\r\nvoid minimalLighting_float(\r\n    float3 PositionWS, \r\n    float3 NormalWS, \r\n    out float3 LightProbeGI, \r\n    out float ShadowAttenuation,\r\n    out float3 MainLightColor,\r\n    out float3 MainLightDir\r\n) {\r\n#ifdef SHADERGRAPH_PREVIEW\r\n    LightProbeGI = float3(0.4, 0.4, 0.4);\r\n    ShadowAttenuation = 1.0;\r\n    MainLightColor = float3(1.0, 1.0, 1.0);\r\n    MainLightDir = float3(0.5, 0.5, -0.5);\r\n#else\r\n    LightProbeGI = SampleSH(NormalWS);\r\n    float4 shadowCoord = TransformWorldToShadowCoord(PositionWS);\r\n    Light mainLight = GetMainLight(shadowCoord, PositionWS, 1);\r\n    \r\n    ShadowAttenuation = mainLight.shadowAttenuation;\r\n    MainLightColor = mainLight.color;\r\n    MainLightDir = mainLight.direction;\r\n#endif\r\n}\r\n\r\nvoid minimalLighting_half(\r\n    half3 PositionWS, \r\n    half3 NormalWS, \r\n    out half3 LightProbeGI, \r\n    out half ShadowAttenuation,\r\n    out half3 MainLightColor,\r\n    out half3 MainLightDir\r\n) {\r\n    float3 lpGI, mlColor, mlDir;\r\n    float sAtten;\r\n    \r\n    minimalLighting_float((float3)PositionWS, (float3)NormalWS, lpGI, sAtten, mlColor, mlDir);\r\n    \r\n    LightProbeGI = (half3)lpGI;\r\n    ShadowAttenuation = (half)sAtten;\r\n    MainLightColor = (half3)mlColor;\r\n    MainLightDir = (half3)mlDir;\r\n}\r\n\r\n#endif"
}

